---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PrivacyBody from '../components/PrivacyBody.astro';
import { es } from '../i18n/es';
import { privacy } from '../data/privacy';

const doc = privacy.es;
---

<Base
  locale="es"
  title={doc.metaTitle}
  description={doc.metaDescription}
  skipLabel={es.a11y.skip}
  alternateEs="/privacidad"
  alternateEn="/en/privacy"
>
  <Nav locale="es" dict={es} />
  <main id="main">
    <PrivacyBody doc={doc} />
  </main>
  <Footer dict={es} locale="es" />
</Base>
