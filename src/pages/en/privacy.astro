---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PrivacyBody from '../../components/PrivacyBody.astro';
import { en } from '../../i18n/en';
import { privacy } from '../../data/privacy';

const doc = privacy.en;
---

<Base
  locale="en"
  title={doc.metaTitle}
  description={doc.metaDescription}
  skipLabel={en.a11y.skip}
  alternateEs="/privacidad"
  alternateEn="/en/privacy"
>
  <Nav locale="en" dict={en} />
  <main id="main">
    <PrivacyBody doc={doc} />
  </main>
  <Footer dict={en} locale="en" />
</Base>
