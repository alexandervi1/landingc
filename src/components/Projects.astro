---
import type { Dict, Locale } from '../i18n/types';
import { isPublished, projectPath, visibleProjects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
  dict: Dict;
  locale: Locale;
  number: number;
}

const { dict, locale, number } = Astro.props;
const visible = visibleProjects();
---

<section id="proyectos" class="section">
  <div class="wrap">
    <p class="label">{String(number).padStart(2, '0')} — {dict.projects.label}</p>
    <h2 class="display section-title">{dict.projects.heading}</h2>
    <p class="section-intro">{dict.projects.intro}</p>

    <div class="grid">
      {
        visible.map((project, index) => (
          <ProjectCard
            index={index}
            project={project}
            locale={locale}
            linkLabel={dict.projects.link}
            labels={dict.projects.labels}
            href={isPublished(project) ? projectPath(project, locale) : ''}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .section-title {
    margin-top: 16px;
    font-size: clamp(2rem, 5vw, 4rem);
  }

  .section-intro {
    margin-top: 16px;
    max-width: 52ch;
    color: var(--color-ink-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 48px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
