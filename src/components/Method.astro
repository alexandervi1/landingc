---
import type { Dict } from '../i18n/types';

interface Props {
  dict: Dict;
  number: number;
}

const { dict, number } = Astro.props;
---

<section id="como-trabajo" class="section method">
  <div class="wrap">
    <p class="label">{String(number).padStart(2, '0')} — {dict.method.label}</p>
    <h2 class="display method-title">{dict.method.heading}</h2>

    <ol class="steps">
      {
        dict.method.steps.map((step, index) => (
          <li class="step">
            <span class="label step-number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-text">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .method-title {
    margin-top: 16px;
    font-size: clamp(2rem, 5vw, 4rem);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .step {
    padding-top: 20px;
    border-top: 1px solid var(--color-line-strong);
  }

  .step-number {
    display: block;
    color: var(--color-yellow);
  }

  .step-title {
    margin-top: 12px;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .step-text {
    margin-top: 8px;
    max-width: 34ch;
    font-size: 15px;
    color: var(--color-ink-muted);
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
