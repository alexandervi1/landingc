---
import type { Dict, Locale } from '../i18n/types';
import { localePath } from '../i18n/utils';

interface Props {
  locale: Locale;
  dict: Dict;
}

const { locale, dict } = Astro.props;
const navLabel = locale === 'es' ? 'Navegación principal' : 'Main navigation';
const langLabel = locale === 'es' ? 'Idioma' : 'Language';
---

<header class="nav" data-nav>
  <div class="wrap nav-inner">
    <a class="brand" href={localePath(locale)}>
      <span class="display brand-mark">AV</span>
      <span class="label brand-name">Alexander Villalva</span>
    </a>

    <div class="nav-right">
      <nav class="nav-links" id="nav-menu" aria-label={navLabel} data-nav-menu>
        <a class="label" href="#proyectos">{dict.nav.projects}</a>
        <a class="label" href="#sobre-mi">{dict.nav.about}</a>
        <a class="label" href="#contacto">{dict.nav.contact}</a>
        <a class="btn btn-ghost nav-cta-mobile" href="#contacto">{dict.nav.cta}</a>
      </nav>

      <a class="btn btn-ghost nav-cta" href="#contacto">{dict.nav.cta}</a>

      <div class="lang" role="group" aria-label={langLabel}>
        <a
          class="label lang-link"
          href="/"
          lang="es"
          hreflang="es"
          aria-current={locale === 'es' ? 'page' : undefined}>ES</a
        >
        <span class="lang-sep" aria-hidden="true">/</span>
        <a
          class="label lang-link"
          href="/en/"
          lang="en"
          hreflang="en"
          aria-current={locale === 'en' ? 'page' : undefined}>EN</a
        >
      </div>

      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label={dict.a11y.menu}
        data-nav-toggle
      >
        <span class="nav-toggle-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid transparent;
    background: transparent;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .nav.is-scrolled,
  .nav.is-open {
    background: color-mix(in srgb, var(--color-canvas) 94%, transparent);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--color-line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-ink);
  }

  .brand-mark {
    font-size: 20px;
    letter-spacing: 0;
    line-height: 1;
  }

  /* Visualmente oculto en móvil, visible desde 768px. Mantiene el nombre
     en el árbol de accesibilidad para que coincida con el texto visible. */
  .brand-name {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-links {
    display: none;
  }

  .nav-links a,
  .lang-link {
    text-decoration: none;
    color: var(--color-ink-muted);
  }

  .nav-links a:hover,
  .lang-link:hover {
    color: var(--color-ink);
  }

  .lang-link[aria-current='page'] {
    color: var(--color-ink);
  }

  .nav-cta,
  .nav-cta-mobile {
    display: none;
    height: 36px;
    padding-inline: 14px;
  }

  .lang {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lang-sep {
    color: var(--color-line);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--color-line-strong);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .nav-toggle:hover {
    border-color: var(--color-ink);
  }

  .nav-toggle-bars {
    position: relative;
    display: block;
    width: 16px;
    height: 1px;
    background: currentColor;
    transition: background-color 0.18s ease;
  }

  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    content: '';
    position: absolute;
    left: 0;
    width: 16px;
    height: 1px;
    background: currentColor;
    transition: transform 0.18s ease;
  }

  .nav-toggle-bars::before {
    top: -5px;
  }

  .nav-toggle-bars::after {
    top: 5px;
  }

  .nav.is-open .nav-toggle-bars {
    background: transparent;
  }

  .nav.is-open .nav-toggle-bars::before {
    transform: translateY(5px) rotate(45deg);
  }

  .nav.is-open .nav-toggle-bars::after {
    transform: translateY(-5px) rotate(-45deg);
  }

  @media (max-width: 767px) {
    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      padding: 4px clamp(20px, 4vw, 40px) 20px;
      background: var(--color-canvas);
      border-bottom: 1px solid var(--color-line);
    }

    .nav.is-open .nav-links {
      display: flex;
    }

    .nav-links > a:not(.btn) {
      padding-block: 14px;
      border-top: 1px solid var(--color-line);
      font-size: 12px;
    }

    .nav-cta-mobile {
      display: inline-flex;
      align-self: flex-start;
      margin-top: 16px;
    }
  }

  @media (min-width: 768px) {
    .brand-name {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
    }

    .nav-links {
      display: flex;
      gap: 16px;
    }

    .nav-cta {
      display: inline-flex;
    }

    .nav-toggle {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .nav-links {
      gap: 24px;
    }
  }
</style>
