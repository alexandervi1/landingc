---
import type { Dict, Locale } from '../i18n/types';
import type { Project } from '../data/projects';

interface Props {
  index: number;
  project: Project;
  locale: Locale;
  linkLabel: string;
  href: string;
  labels: Dict['projects']['labels'];
}

const { index, project, locale, linkLabel, href, labels } = Astro.props;
const content = project.content[locale];
---

<article class="card" data-reveal style={`--i:${index}`}>
  <div class="card-top">
    <span class="label">{String(index + 1).padStart(2, '0')}</span>
    <span class="label">{project.year || '—'}</span>
  </div>
  <h3 class="display card-title">{content.title}</h3>
  <p class="card-summary">{content.summary}</p>

  <dl class="card-details">
    <div class="card-detail">
      <dt class="label">{labels?.context ?? 'Contexto'}</dt>
      <dd>{content.context}</dd>
    </div>
    <div class="card-detail">
      <dt class="label">{labels?.role ?? 'Rol'}</dt>
      <dd>{content.role}</dd>
    </div>
    <div class="card-detail">
      <dt class="label">{labels?.result ?? 'Resultado'}</dt>
      <dd>{content.result}</dd>
    </div>
  </dl>

  <ul class="card-stack">
    {project.stack.map((s) => <li class="chip">{s}</li>)}
  </ul>

  {content.note && <p class="card-note">{content.note}</p>}

  <a class="card-link" href={href} hidden={href === ''}>
    {linkLabel} <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border: 1px solid var(--color-line-strong);
    background: var(--color-canvas-2);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .card:hover {
    border-color: var(--color-ink-muted);
    transform: translateY(-2px);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-title {
    font-size: clamp(1.5rem, 2.2vw, 1.75rem);
  }

  .card-summary {
    color: var(--color-ink-muted);
    font-size: 15px;
  }

  .card-details {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  .card-detail dt {
    margin-bottom: 4px;
  }

  .card-detail dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  .card-note {
    padding-top: 12px;
    border-top: 1px solid var(--color-line);
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  .card-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid var(--color-line);
    padding: 4px 8px;
  }

  .card-link {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-blue-lift);
    text-decoration: none;
  }

  .card-link:hover {
    color: var(--color-ink);
  }
</style>
