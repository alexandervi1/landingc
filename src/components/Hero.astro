---
import type { Dict } from '../i18n/types';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const [line1, line2, line3] = dict.hero.title;
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="label eyebrow">{dict.hero.eyebrow}</p>
      <h1 class="display hero-title">
        <span class="line">{line1}</span>
        <span class="line">{line2}</span>
        <span class="line accent">{line3}</span>
      </h1>
      <p class="hero-lead">{dict.hero.lead}</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="#proyectos">{dict.hero.ctaPrimary}</a>
        <a class="btn btn-ghost" href="#contacto">{dict.hero.ctaSecondary}</a>
      </div>
    </div>

    <div class="hero-art">
      <div class="terminal">
        <div class="terminal-bar">
          <span class="label">{dict.hero.terminal.label}</span>
          <span class="dots" aria-hidden="true">
            <i class="dot dot-y"></i>
            <i class="dot dot-b"></i>
            <i class="dot dot-l"></i>
          </span>
        </div>
        <div class="terminal-body">
          {
            dict.hero.terminal.blocks.map((block) => (
              <div class="block">
                <p class="cmd">
                  <span class="prompt">$</span> {block.cmd}
                </p>
                <p class="out">{block.out}</p>
              </div>
            ))
          }
          <span class="caret" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(96px, 14vh, 160px) clamp(64px, 10vh, 120px);
    overflow: clip;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--color-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-line) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.35;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 30%, transparent 75%);
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(circle at 78% 18%, rgba(0, 0, 242, 0.45), transparent 55%);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }

  .eyebrow {
    display: flex;
    align-items: center;
  }

  .eyebrow::before {
    content: '';
    display: inline-block;
    width: 24px;
    height: 2px;
    margin-right: 10px;
    background: var(--color-yellow);
  }

  .hero-title {
    margin-top: 20px;
    font-size: clamp(2.75rem, 8.2vw, 7rem);
  }

  .line {
    display: block;
  }

  .accent {
    color: var(--color-yellow);
  }

  .hero-lead {
    margin-top: 24px;
    max-width: 46ch;
    font-size: 18px;
    color: var(--color-ink-muted);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .terminal {
    border: 1px solid var(--color-line);
    background: var(--color-canvas-2);
    border-radius: 0;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.7;
    margin-top: 40px;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--color-line);
    padding: 10px 16px;
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .dot-y {
    background: var(--color-yellow);
  }

  .dot-b {
    background: var(--color-blue-lift);
  }

  .dot-l {
    background: var(--color-line);
  }

  .terminal-body {
    padding: 18px 16px;
  }

  .block + .block {
    margin-top: 12px;
  }

  .cmd {
    color: var(--color-ink);
  }

  .prompt {
    color: var(--color-yellow);
  }

  .out {
    color: var(--color-ink-muted);
  }

  .caret {
    display: inline-block;
    width: 8px;
    height: 14px;
    background: var(--color-yellow);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: repeat(12, 1fr);
    }

    .hero-copy {
      grid-column: span 7;
    }

    .hero-art {
      grid-column: span 5;
    }

    .terminal {
      margin-top: 0;
    }
  }
</style>
