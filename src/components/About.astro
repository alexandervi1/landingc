---
import type { Dict } from '../i18n/types';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
---

<section id="sobre-mi" class="section about">
  <div class="wrap about-grid">
    <figure class="about-photo">
      <picture>
        <source srcset="/foto-560.webp" type="image/webp" />
        <img
          src="/foto.jpg"
          alt={dict.about.photoAlt}
          width="1080"
          height="1055"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </figure>

    <div class="about-copy">
      <p class="label">{dict.about.label}</p>
      <h2 class="display about-title">{dict.about.heading}</h2>
      {
        dict.about.paragraphs.map((paragraph, index) => (
          <p class={index === 0 ? 'lead' : 'sub'}>{paragraph}</p>
        ))
      }

      <dl class="facts">
        {
          dict.about.facts.map((fact) => (
            <div class="fact">
              <dt class="label">{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <dl class="stack">
      {
        dict.about.groups.map((group) => (
          <div class="group">
            <dt class="label group-label">{group.label}</dt>
            <dd class="group-items">
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .about {
    background: var(--color-canvas-2);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }

  .about-photo {
    margin: 0;
    max-width: 260px;
  }

  .about-photo picture {
    display: block;
  }

  .about-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 55% 30%;
    height: auto;
    border: 1px solid var(--color-line-strong);
  }

  .about-title {
    margin-top: 16px;
    font-size: clamp(2rem, 5vw, 4rem);
  }

  .facts {
    margin: 32px 0 0;
    border-top: 1px solid var(--color-line);
  }

  .fact {
    display: grid;
    grid-template-columns: 128px 1fr;
    gap: 16px;
    padding-block: 10px;
    border-bottom: 1px solid var(--color-line);
    font-size: 14px;
  }

  .fact dt {
    padding-top: 2px;
  }

  .fact dd {
    margin: 0;
  }

  .lead {
    margin-top: 24px;
    max-width: 60ch;
    color: var(--color-ink);
  }

  .sub {
    margin-top: 16px;
    max-width: 60ch;
    color: var(--color-ink-muted);
  }

  .stack {
    margin: 0;
  }

  .group-label {
    padding-block: 12px;
  }

  .group-items {
    margin: 0;
  }

  .group-items ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .group-items li {
    border-top: 1px solid var(--color-line);
    padding-block: 10px;
    font-size: 15px;
  }

  .group:first-child .group-items li:first-child {
    border-top: 0;
  }

  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: repeat(12, 1fr);
      gap: 64px;
      align-items: start;
    }

    .about-photo {
      grid-column: span 3;
      max-width: none;
    }

    .about-copy {
      grid-column: span 9;
    }

    .facts {
      max-width: 560px;
    }

    .stack {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 0 32px;
    }
  }
</style>
