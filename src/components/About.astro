---
import type { Dict } from '../i18n/types';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const [first, second] = dict.about.paragraphs;
---

<section id="sobre-mi" class="section about">
  <div class="wrap about-grid">
    <div class="about-copy">
      <p class="label">{dict.about.label}</p>
      <h2 class="display about-title">{dict.about.heading}</h2>
      <p class="lead">{first}</p>
      <p class="sub">{second}</p>
    </div>

    <dl class="stack">
      {
        dict.about.groups.map((group) => (
          <div class="group">
            <dt class="label group-label">{group.label}</dt>
            <dd class="group-items">
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .about {
    background: var(--color-canvas-2);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }

  .about-title {
    margin-top: 16px;
    font-size: clamp(2rem, 5vw, 4rem);
  }

  .lead {
    margin-top: 24px;
    max-width: 60ch;
    color: var(--color-ink);
  }

  .sub {
    margin-top: 16px;
    max-width: 60ch;
    color: var(--color-ink-muted);
  }

  .stack {
    margin: 0;
  }

  .group-label {
    padding-block: 12px;
  }

  .group-items {
    margin: 0;
  }

  .group-items ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .group-items li {
    border-top: 1px solid var(--color-line);
    padding-block: 10px;
    font-size: 15px;
  }

  .group:first-child .group-items li:first-child {
    border-top: 0;
  }

  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: repeat(12, 1fr);
      gap: 64px;
    }

    .about-copy {
      grid-column: span 7;
    }

    .stack {
      grid-column: span 5;
    }
  }
</style>
