---
import type { Dict } from '../i18n/types';
import { links, stack } from '../data/site';

interface Props {
  dict: Dict;
  number: number;
}

const { dict, number } = Astro.props;
const daily = stack.filter((item) => item.tier === 'daily').map((item) => item.name);
const known = stack.filter((item) => item.tier === 'known').map((item) => item.name);
---

<section id="sobre-mi" class="section about">
  <div class="wrap about-grid">
    <figure class="about-photo">
      <picture>
        <source srcset="/foto-560.webp" type="image/webp" />
        <img
          src="/foto.jpg"
          alt={dict.about.photoAlt}
          width="1080"
          height="1055"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </figure>

    <div class="about-copy">
      <p class="label">{String(number).padStart(2, '0')} — {dict.about.label}</p>
      <h2 class="display about-title">{dict.about.heading}</h2>
      {
        dict.about.paragraphs.map((paragraph, index) => (
          <p class={index === 0 ? 'lead' : 'sub'}>{paragraph}</p>
        ))
      }

      <dl class="facts">
        {
          dict.about.facts.map((fact) => (
            <div class="fact">
              <dt class="label">{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="about-cta">
        <a class="btn btn-primary" href="#contacto">{dict.about.cta.email}</a>
        {links.github && <a class="btn btn-ghost" href={links.github}>{dict.about.cta.github}</a>}
        {links.linkedin && (
          <a class="btn btn-ghost" href={links.linkedin}>{dict.about.cta.linkedin}</a>
        )}
      </div>
    </div>

    <div class="stack">
      <div class="group">
        <p class="label group-label">
          <span class="group-dot group-dot-accent" aria-hidden="true"></span>
          {dict.about.stack.daily}
        </p>
        <ul class="chips chips-daily">
          {
            daily.map((name) => (
              <li class="chip chip-daily">{name}</li>
            ))
          }
        </ul>
      </div>
      <div class="group">
        <p class="label group-label">
          <span class="group-dot" aria-hidden="true"></span>
          {dict.about.stack.known}
        </p>
        <ul class="chips chips-known">
          {
            known.map((name) => (
              <li class="chip chip-known">{name}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--color-canvas-2);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }

  .about-photo {
    margin: 0;
    max-width: 260px;
  }

  .about-photo picture {
    display: block;
  }

  .about-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 55% 30%;
    height: auto;
    border: 1px solid var(--color-line-strong);
  }

  .about-title {
    margin-top: 16px;
    font-size: clamp(2rem, 5vw, 4rem);
  }

  .facts {
    margin: 32px 0 0;
    border-top: 1px solid var(--color-line);
  }

  .fact {
    display: grid;
    grid-template-columns: 128px 1fr;
    gap: 16px;
    padding-block: 10px;
    border-bottom: 1px solid var(--color-line);
    font-size: 14px;
  }

  .fact dt {
    padding-top: 2px;
  }

  .fact dd {
    margin: 0;
  }

  .about-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .lead {
    margin-top: 24px;
    max-width: 60ch;
    color: var(--color-ink);
  }

  .sub {
    margin-top: 16px;
    max-width: 60ch;
    color: var(--color-ink-muted);
  }

  .stack {
    margin: 0;
  }

  .group-label {
    padding-block: 12px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 7px 12px;
    border: 1px solid var(--color-line-strong);
    font-size: 14px;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--color-ink);
  }

  .chip-daily {
    border-left: 3px solid var(--color-yellow);
    padding-left: 10px;
  }

  .chip-known {
    padding: 5px 10px;
    border-color: var(--color-line);
    font-size: 13px;
    color: var(--color-ink-muted);
  }

  .group-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    vertical-align: middle;
    background: var(--color-line-strong);
  }

  .group-dot-accent {
    background: var(--color-yellow);
  }

  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: repeat(12, 1fr);
      gap: 64px;
      align-items: start;
    }

    .about-photo {
      grid-column: span 3;
      max-width: none;
    }

    .about-copy {
      grid-column: span 9;
    }

    .facts {
      max-width: 560px;
    }

    .stack {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 0 32px;
    }
  }
</style>
