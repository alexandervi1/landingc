---
import '../styles/global.css';
import type { Locale } from '../i18n/types';
import { site as profile, links } from '../data/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  skipLabel: string;
  alternateEs?: string;
  alternateEn?: string;
}

const {
  locale,
  title,
  description,
  skipLabel,
  alternateEs = '/',
  alternateEn = '/en/',
} = Astro.props;
const siteUrl = Astro.site ?? new URL('https://alexandervillalva.uk');
const canonical = new URL(Astro.url.pathname, siteUrl);
const alternateEsUrl = new URL(alternateEs, siteUrl);
const alternateEnUrl = new URL(alternateEn, siteUrl);
const ogLocale = locale === 'es' ? 'es_EC' : 'en_US';
const ogLocaleAlternate = locale === 'es' ? 'en_US' : 'es_EC';
const ogImage = new URL('/og-image.png', siteUrl);
const jobTitle = locale === 'es' ? profile.role : 'Software Engineer';
const ogImageAlt = `${profile.name} — ${jobTitle}`;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle,
  url: canonical.href,
  email: `mailto:${profile.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: profile.city,
    addressCountry: profile.country,
  },
  sameAs: [links.github, links.linkedin].filter(Boolean),
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={alternateEsUrl} />
    <link rel="alternate" hreflang="en" href={alternateEnUrl} />
    <link rel="alternate" hreflang="x-default" href={alternateEsUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#0d0d24" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a href="#main" class="skip">{skipLabel}</a>
    <slot />
    <script>
      const nav = document.querySelector('[data-nav]');
      const setNav = () => nav?.classList.toggle('is-scrolled', window.scrollY > 8);
      setNav();
      addEventListener('scroll', setNav, { passive: true });

      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const menu = document.querySelector<HTMLElement>('[data-nav-menu]');
      const desktop = matchMedia('(min-width: 768px)');

      const setMenu = (open: boolean) => {
        nav?.classList.toggle('is-open', open);
        toggle?.setAttribute('aria-expanded', String(open));
      };

      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        setMenu(open);
        if (open) menu?.querySelector('a')?.focus();
      });

      menu?.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a')) setMenu(false);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || toggle?.getAttribute('aria-expanded') !== 'true') return;
        setMenu(false);
        toggle.focus();
      });

      desktop.addEventListener('change', (event) => {
        if (event.matches) setMenu(false);
      });

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries)
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
    <style>
      .skip {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 50;
        background: var(--color-yellow);
        color: #0d0d24;
        padding: 10px 14px;
        font-family: var(--font-mono);
        font-size: 12px;
        text-transform: uppercase;
        transform: translateY(-200%);
      }

      .skip:focus-visible {
        transform: none;
      }
    </style>
  </body>
</html>
