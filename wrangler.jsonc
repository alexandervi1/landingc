{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "landing",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "vars": {
    "CONTACT_TO": "hola@alexandervillalva.uk",
    "CONTACT_FROM": "Alexander Villalva <hola@alexandervillalva.uk>"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "alexandervillalva.uk", "custom_domain": true }]
}
